# ====================================================================
# Real-Estate RAG Assistant Configuration
# Run directly with cloud APIs (no Ollama installation or download needed!)
# ====================================================================

# --------------------------------------------------------------------
# 1. Choose your LLM Provider and set your API key:
# --------------------------------------------------------------------

# --- Option A: BigModel / Zhipu AI (Free tier with glm-4-flash) ---
LLM_PROVIDER=bigmodel
LLM_API_KEY=your_bigmodel_api_key
LLM_MODEL=glm-4-flash

# --- Option B: Groq (Fast, free cloud tier with Llama 3) ---
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your_groq_api_key
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option C: OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your_openai_api_key
# LLM_MODEL=gpt-4o-mini

# --- Option D: OpenRouter ---
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-your_key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Option E: DeepSeek ---
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your_deepseek_api_key
# LLM_MODEL=deepseek-chat

# --- Option F: Any custom OpenAI-compatible API endpoint ---
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-api-endpoint.com/v1
# LLM_API_KEY=your_api_key
# LLM_MODEL=your_model_name

# --- Option G: Local Ollama (optional, if you have Ollama installed) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4:e4b
# OLLAMA_HOST=http://localhost:11434

# --------------------------------------------------------------------
# 2. Embeddings (runs locally via sentence-transformers, free, multilingual)
# --------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --------------------------------------------------------------------
# 3. Knowledge sources
# --------------------------------------------------------------------
PDF_DIR=data/pdfs
# Google Sheet: a share link ("Anyone with the link can view") or a local .csv/.xlsx path
SHEET_SOURCE=data/units.csv
INDEX_DIR=index
# Maximum rows loaded from each sheet into the RAG knowledge index
MAX_RAG_SHEET_ROWS=5000

# --------------------------------------------------------------------
# 4. API service
# --------------------------------------------------------------------
# If set, every staff endpoint needs the header X-API-Key
API_KEY=
RADAR_DB=data/radar.db

# --------------------------------------------------------------------
# 5. Daily price automation
# --------------------------------------------------------------------
# Changes bigger than this percentage wait for approval
PRICE_CHANGE_HOLD_PCT=25
AUTO_REBUILD_INDEX=1
INGEST_USE_LLM_FALLBACK=1
# Shared secret for POST /ingest/webhook (WhatsApp / n8n / Make)
INGEST_WEBHOOK_TOKEN=change-me
# Telegram price group
TELEGRAM_BOT_TOKEN=
# Comma-separated group ids; send /chatid in the group to get it
TELEGRAM_PRICE_CHAT_IDS=
TELEGRAM_REPLY_IN_GROUP=1
# Where daily files from the bot are stored, and the max size (Telegram limit is 20 MB)
DOCS_DIR=data/documents
MAX_DOCUMENT_MB=20

# --------------------------------------------------------------------
# 6. Client chatbot (a separate Telegram bot that buyers talk to)
# --------------------------------------------------------------------
TELEGRAM_CLIENT_BOT_TOKEN=
# If set, POST /client/chat needs the header X-Client-Key
CLIENT_API_KEY=
# 0 = the client bot never reads or writes the CRM (default). 1 = shared phone numbers become leads.
CLIENT_SAVE_LEADS=0
CLIENT_MAX_UNITS=3
# Shown when a client wants to visit or talk to someone, e.g. "كلمنا على 0100 000 0000"
CLIENT_CONTACT_TEXT=

# --------------------------------------------------------------------
# 7. Sales assistant (uses TELEGRAM_BOT_TOKEN)
# --------------------------------------------------------------------
# Sales group id and/or salespeople's private chat ids (send /chatid to the bot)
TELEGRAM_SALES_CHAT_IDS=
SALES_NOTES_FILE=data/xlsx/sales_notes.xlsx
# 0 = sales bot sees units only (default). 1 = also /priority /clusters /lead /recommend /newleads
SALES_CRM_ACCESS=0

# --------------------------------------------------------------------
# 8. Three bots
# --------------------------------------------------------------------
# Main bot chats with full access here (your private chat id). Price chats receive the daily data.
TELEGRAM_ADMIN_CHAT_IDS=
# Third bot for the sales team (all units, read only). Its users go in TELEGRAM_SALES_CHAT_IDS.
TELEGRAM_SALES_BOT_TOKEN=
